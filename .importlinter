[importlinter]
root_package = polis

[importlinter:contract:events-boundary]
name = Events only depend on config
type = forbidden
source_modules =
    polis.events
forbidden_modules =
    polis.kernel
    polis.store
    polis.llm
    polis.agents
    polis.world
    polis.observatory
    polis.research

[importlinter:contract:kernel-boundary]
name = Kernel does not know domain modules
type = forbidden
source_modules =
    polis.kernel
forbidden_modules =
    polis.agents
    polis.world
    polis.observatory
    polis.research

[importlinter:contract:observatory-read-only]
name = Observatory does not import engine or agent cognition
type = forbidden
source_modules =
    polis.observatory
forbidden_modules =
    polis.kernel
    polis.agents
    polis.research

[importlinter:contract:economy-boundary]
name = Economy institutions never import agent cognition
type = forbidden
source_modules =
    polis.economy
forbidden_modules =
    polis.agents.cognition

[importlinter:contract:institutions-no-cognition]
name = Institutions consume actions without importing agent internals
type = forbidden
source_modules =
    polis.economy
    polis.society
    polis.world
forbidden_modules =
    polis.agents.cognition
    polis.agents.memory
    polis.agents.state
ignore_imports =
    polis.economy.banking -> polis.agents.state
    polis.economy.credit -> polis.agents.state
    polis.economy.exchange.engine -> polis.agents.state
    polis.economy.fiscal -> polis.agents.state
    polis.economy.genesis -> polis.agents.state
    polis.economy.goods -> polis.agents.state
    polis.economy.labour -> polis.agents.state
    polis.economy.policy -> polis.agents.state
    polis.economy.state -> polis.agents.state
    polis.economy.ventures -> polis.agents.state

[importlinter:contract:gateway_readmodel_only]
name = Gateway is isolated from engine and agent internals
type = forbidden
source_modules =
    polis.gateway
forbidden_modules =
    polis.kernel
    polis.agents
    polis.store
ignore_imports =
    polis.gateway.tools -> polis.store.readmodels.external
